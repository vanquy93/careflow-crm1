{
  "name": "careflow-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:server": "node server/index.js",
    "start:lan": "concurrently \"node server/index.js\" \"vite --host\"",
    "build:desktop": "vite build && electron-builder",
    "electron:dev": "concurrently \"vite\" \"electron .\""
  },
  "build": {
    "appId": "com.careflow.crm",
    "productName": "Careflow CRM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/db.json",
      "electron/main.js",
      "node_modules/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "html2pdf.js": "^0.14.0",
    "json-server": "^1.0.0-beta.15",
    "lucide-react": "^1.22.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-big-calendar": "^1.20.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "react-router-dom": "^7.18.1",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "wait-on": "^9.0.10"
  }
}
